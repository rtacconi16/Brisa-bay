# Copy to .env and fill in values from Meta Developer / Instagram Graph API.
# @brisabay must be a Professional (Business or Creator) account.

# Instagram professional account ID (IG User ID)
INSTAGRAM_USER_ID=

# Long-lived access token with permission to read media
# Instagram Login apps: instagram_business_basic
# Facebook Login apps: instagram_basic + pages_read_engagement
INSTAGRAM_ACCESS_TOKEN=

# graph.instagram.com  (Instagram Login)  OR  graph.facebook.com (Facebook Login)
INSTAGRAM_GRAPH_HOST=graph.instagram.com

INSTAGRAM_API_VERSION=v21.0

# Cache Instagram responses (seconds)
INSTAGRAM_CACHE_TTL=900

PORT=8080
