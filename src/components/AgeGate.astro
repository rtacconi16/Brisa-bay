<div data-bb-age-gate="" role="dialog" aria-modal="true" tabindex="-1" aria-label="Age verification. You must confirm you are of legal drinking age before entering." style="position: fixed; inset: 0; background: rgba(60,58,52,0.95); display: flex; align-items: center; justify-content: center; padding: clamp(16px, 3vw, 60px); z-index: 1200; font-family: 'EB Garamond', serif">
  <div style="background: var(--bb-cream); width: 100%; max-width: 820px; padding: clamp(36px, 4.4vw, 84px) clamp(24px, 5vw, 96px); box-sizing: border-box; text-align: center">
    <div style="font-size: clamp(24px, 2.3vw, 44px); color: var(--bb-ink); margin-bottom: clamp(18px, 1.8vw, 34px)">Brisa Bay</div>
    <div data-bb-gate-ask="">
      <h2 style="margin: 0 0 clamp(18px, 1.8vw, 34px); font-size: clamp(28px, 3.1vw, 58px); font-weight: 400; color: var(--bb-ink); text-wrap: balance">Welcome to the brighter side of Napa.</h2>
      <p style="margin: 0 0 clamp(26px, 2.5vw, 48px); font-size: clamp(16px, 1.6vw, 30px); color: var(--bb-ink); text-wrap: pretty">Before you come in, please confirm you are of legal drinking age — 21 or older in the United States.</p>
      <div style="display: flex; flex-wrap: wrap; gap: clamp(12px, 1.2vw, 22px); justify-content: center">
        <div data-bb-gate-accept="" role="button" tabindex="0" style="background: var(--bb-lime); color: var(--bb-cream); font-family: 'Old Newspaper', serif; font-size: clamp(17px, 1.6vw, 30px); padding: clamp(12px, 0.95vw, 18px) clamp(30px, 2.7vw, 52px) clamp(15px, 1.15vw, 22px); border-radius: 999px; cursor: pointer; transition: transform 0.25s" style-hover="transform: scale(1.06)">I'm 21 or older</div>
        <div data-bb-gate-deny="" role="button" tabindex="0" style="background: transparent; border: 2px solid rgba(87,84,74,0.4); color: var(--bb-ink); font-family: 'Old Newspaper', serif; font-size: clamp(17px, 1.6vw, 30px); padding: clamp(10px, 0.8vw, 16px) clamp(26px, 2.3vw, 44px) clamp(13px, 1vw, 20px); border-radius: 999px; cursor: pointer; transition: transform 0.25s" style-hover="transform: scale(1.06); border-color: var(--bb-red); color: var(--bb-red)">I'm under 21</div>
      </div>
      <p style="margin: clamp(26px, 2.5vw, 48px) 0 0; font-size: clamp(14px, 1.2vw, 22px); line-height: 1.5; color: rgba(87,84,74,0.7); text-wrap: pretty">We never sell or market alcohol to anyone under the legal drinking age. Please enjoy Brisa Bay responsibly.</p>
    </div>
    <div data-bb-gate-denied="" hidden>
      <h2 style="margin: 0 0 clamp(18px, 1.8vw, 34px); font-size: clamp(28px, 3.1vw, 58px); font-weight: 400; color: var(--bb-ink); text-wrap: balance">Come back and see us at 21.</h2>
      <p style="margin: 0 0 clamp(26px, 2.5vw, 48px); font-size: clamp(16px, 1.6vw, 30px); color: var(--bb-ink); text-wrap: pretty">Thanks for stopping by. There's a bottle waiting for you when the time is right.</p>
      <div data-bb-gate-retry="" role="button" tabindex="0" style="display: inline-flex; background: transparent; border: 2px solid rgba(87,84,74,0.4); color: var(--bb-ink); font-family: 'Old Newspaper', serif; font-size: clamp(17px, 1.6vw, 30px); padding: clamp(10px, 0.8vw, 16px) clamp(26px, 2.3vw, 44px) clamp(13px, 1vw, 20px); border-radius: 999px; cursor: pointer; transition: transform 0.25s" style-hover="transform: scale(1.06); border-color: var(--bb-lime); color: var(--bb-lime)">I made a mistake</div>
    </div>
  </div>
</div>
