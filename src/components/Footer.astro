---
import { CONTACT_EMAIL, INSTAGRAM, copyright } from '../data/site';
interface Props {
  active?: string;
  faq?: boolean;
}
const { active = '', faq = false } = Astro.props;
const yearLine = copyright();
---
<div data-screen-label="Footer" role="contentinfo" style="position: relative; background: var(--bb-sage); padding: clamp(56px, 6.6vw, 126px) clamp(20px, 5vw, 190px) clamp(40px, 4.2vw, 80px); box-sizing: border-box">
  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: clamp(30px, 5vw, 80px)">
    <div style="font-size: clamp(48px, 8.4vw, 160px); line-height: 1; color: var(--bb-cream)">Brisa Bay</div>
    <div style="display: flex; flex-wrap: wrap; gap: clamp(36px, 6.3vw, 120px)">
      <div style="display: flex; flex-direction: column; gap: clamp(6px, 0.8vw, 14px); font-size: clamp(16px, 1.7vw, 32px); color: var(--bb-cream)">
        {active === 'wines'
          ? <span style="cursor: default; color: var(--bb-yellow)">Our Wines</span>
          : <a href="/ourWines" style="color: inherit; text-decoration: none" style-hover="color: var(--bb-yellow)">Our Wines</a>}
        {active === 'locator'
          ? <span style="cursor: default; color: var(--bb-yellow)">Store Locator</span>
          : <a href="/findBrisaBay" style="color: inherit; text-decoration: none" style-hover="color: var(--bb-yellow)">Store Locator</a>}
      </div>
      <div style="display: flex; flex-direction: column; gap: clamp(6px, 0.8vw, 14px); font-size: clamp(16px, 1.7vw, 32px); color: var(--bb-cream)">
        {active === 'about'
          ? <span style="cursor: default; color: var(--bb-yellow)">About Us</span>
          : <a href="/about" style="color: inherit; text-decoration: none" style-hover="color: var(--bb-yellow)">About Us</a>}
        <a href={`mailto:${CONTACT_EMAIL}`} style="color: inherit; text-decoration: none" style-hover="color: var(--bb-yellow)">Contact</a>
        {faq && (
          <a href="#faqs" data-bb-faq-open="" style="color: inherit; text-decoration: none; cursor: pointer" style-hover="color: var(--bb-yellow)">FAQs</a>
        )}
      </div>
    </div>
  </div>
  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: clamp(20px, 3vw, 40px); margin-top: clamp(34px, 2.9vw, 54px)">
    <div style="display: flex; flex-wrap: wrap; gap: clamp(18px, 4.2vw, 80px); font-size: clamp(15px, 1.6vw, 30px); color: var(--bb-cream)">
      {active === 'privacy'
        ? <span style="cursor: default; color: var(--bb-yellow)">Privacy Policy</span>
        : <a href="/privacy" style="color: inherit; text-decoration: none" style-hover="color: var(--bb-yellow)">Privacy Policy</a>}
      {active === 'terms'
        ? <span style="cursor: default; color: var(--bb-yellow)">Terms of Service</span>
        : <a href="/terms" style="color: inherit; text-decoration: none" style-hover="color: var(--bb-yellow)">Terms of Service</a>}
      {active === 'accessibility'
        ? <span style="cursor: default; color: var(--bb-yellow)">Accessibility</span>
        : <a href="/accessibility" style="color: inherit; text-decoration: none" style-hover="color: var(--bb-yellow)">Accessibility</a>}
      <span>{yearLine}</span>
    </div>
    <div style="display: flex; gap: clamp(12px, 1.4vw, 26px)">
      <a href={INSTAGRAM} target="_blank" rel="noopener" aria-label="Brisa Bay on Instagram" style="width: clamp(42px, 3vw, 58px); height: clamp(42px, 3vw, 58px); border-radius: 50%; background: var(--bb-cream); display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none; transition: transform 0.25s" style-hover="transform: scale(1.1)">
        <svg width="55%" height="55%" viewBox="0 0 24 24" fill="none" stroke="#60b98f" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r="1.3" fill="#60b98f" stroke="none"></circle></svg>
      </a>
    </div>
  </div>
</div>
