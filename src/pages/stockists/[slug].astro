---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { orgJsonLd, websiteJsonLd } from '../../data/site';
import { allStockistPages, stockistJsonLd, stockistBreadcrumb } from '../../data/stockists';

const slug = Astro.params.slug;
const page = allStockistPages().find((p) => p.slug === slug);
if (!page) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const jsonLd = [orgJsonLd(), websiteJsonLd(), stockistJsonLd(page), stockistBreadcrumb(page)];
---
<Layout
  title={page.title}
  description={page.description}
  path={`/stockists/${page.slug}`}
  ogImage="og-locator.jpg"
  jsonLd={jsonLd}
  active="locator"
>
  <div style="background:var(--bb-dark);padding:clamp(20px,3vw,44px) clamp(20px,4.7vw,90px) clamp(40px,5vw,72px);box-sizing:border-box">
    <Nav active="locator" />
    <h1 style="margin:clamp(36px,5vw,72px) 0 0;font-family:'Old Newspaper',serif;font-size:clamp(32px,4.6vw,72px);line-height:1.08;font-weight:400;letter-spacing:0.03em;color:var(--bb-cream)">{page.h1}</h1>
  </div>
  <div style="padding:clamp(36px,5vw,80px) clamp(20px,5vw,190px) clamp(64px,8vw,120px);box-sizing:border-box">
    <p style="margin:0 0 28px;max-width:46em;font-size:clamp(18px,1.7vw,28px);line-height:1.45">{page.lead}</p>
    <p style="margin:0 0 36px;font-size:clamp(16px,1.4vw,22px)">
      <a href="/ourWines#chardonnay">Chardonnay</a>
      {' · '}
      <a href="/ourWines#sauvignon-blanc">Sauvignon Blanc</a>
      {' · '}
      <a href="/findBrisaBay">Full locator</a>
    </p>
    {page.cityLinks && page.cityLinks.length > 0 && (
      <>
        <h2 style="font-family:'Old Newspaper',serif;font-weight:400;font-size:clamp(22px,2.4vw,36px)">Cities with their own pages</h2>
        <ul style="margin:0 0 36px;padding-left:1.2em;font-size:clamp(16px,1.5vw,24px)">
          {page.cityLinks.map((c) => (
            <li>
              <a href={`/stockists/${c.slug}`}>{c.locality}</a> — {c.n} stockists
            </li>
          ))}
        </ul>
        <h2 style="font-family:'Old Newspaper',serif;font-weight:400;font-size:clamp(22px,2.4vw,36px)">Other {page.stateName} stockists</h2>
      </>
    )}
    <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:22px">
      {page.list.map((s) => (
        <li>
          <h2>{s.name}</h2>
          <p>{s.type} · {s.address}, {s.city}</p>
          {s.phone && (
            <p>
              <a href={`tel:${s.phone.replace(/[^\d+]/g, '')}`}>{s.phone}</a>
            </p>
          )}
        </li>
      ))}
    </ul>
  </div>
</Layout>
